{
  "functions": {
    "api/seo.mjs": { "includeFiles": "build/index.html" }
  },
  "routes": [
    {
      "src": "/events/destinacije/([^/]+)/?",
      "dest": "/api/seo?type=destination&slug=$1"
    },
    { "src": "/destinacije/?", "dest": "/api/seo?type=destinations" },
    { "src": "/destinacije-sitemap\\.xml", "dest": "/api/seo?type=destination-sitemap" },
    { "handle": "filesystem" },
    { "src": "/(?!api/).*", "dest": "/index.html" }
  ]
}
